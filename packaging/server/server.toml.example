# omachat-server configuration. Copy to /etc/omachat/server.toml.

[server]
name = "OmaChat"
bind = "0.0.0.0"
port = 6473              # TCP, TLS 1.3 control/text
registration_open = true # set false after creating your accounts
node_id = 1              # 0..1023, unique per server process

[media]
udp_port = 6474          # UDP voice/media
voice_bitrate = 40000

[database]
type = "sqlite"
path = "/var/lib/omachat/omachat.db"

[tls]
# Public CA, private CA or self-signed are all fine. Generate a self-signed
# pair with:
#   omachat-server generate-cert --cert /var/lib/omachat/cert.pem \
#       --key /var/lib/omachat/key.pem --name chat.example.org
certificate = "/var/lib/omachat/cert.pem"
private_key = "/var/lib/omachat/key.pem"

[files]
path = "/var/lib/omachat/files"
max_upload_mb = 50

[auth]
access_token_minutes = 15
refresh_token_days = 30

# After registering your own account, add this section and restart the server.
# The account must already exist; an unknown name prevents startup. This is
# instance administration, separate from ownership of an individual community.
# [operator]
# username = "your-account-name"
# remote_restart = false  # set true only with systemd/Docker restart supervision

# OAuth login/registration. Leave a provider's section out (or its client_id
# / client_secret empty) to keep it disabled; the client only ever sees
# providers the server advertises. `enabled` defaults to true once both an
# id and a secret are set, so it rarely needs to be written explicitly.
#
# The redirect URI you register with each provider is a loopback address
# chosen by the client at login time (http://127.0.0.1:<ephemeral-port>/callback),
# so there is nothing to configure here for it — just enable "loopback"
# / "installed app" style redirects on the provider side if it asks.
#
# [oauth.discord]
# client_id = "your-discord-application-id"
# client_secret = "your-discord-application-secret"
#
# [oauth.github]
# client_id = "your-github-oauth-app-client-id"
# client_secret = "your-github-oauth-app-client-secret"
#
# [oauth.google]
# client_id = "your-google-oauth-client-id.apps.googleusercontent.com"
# client_secret = "your-google-oauth-client-secret"

[limits]
max_connections_per_ip = 16

[log]
level = "info"
